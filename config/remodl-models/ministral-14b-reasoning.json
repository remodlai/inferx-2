{
    "image": "remodlai/vllm-openai-mcp:v0.12.0",
    "commands": [
        "/root/.cache/huggingface/hub/models--mistralai--Ministral-3-14B-Reasoning-2512/snapshots/7efc3c14cb5b7076a88967f15634fd8515cd823a",
        "--trust-remote-code",
        "--max-model-len",
        "50000",
        "--tokenizer_mode",
        "mistral",
        "--config_format",
        "mistral",
        "--load_format",
        "mistral",
        "--enable-auto-tool-choice",
        "--tool-call-parser",
        "mistral",
        "--reasoning-parser",
        "mistral",
        "--served-model-name",
        "mistralai/Ministral-3-14B-Reasoning-2512",
        "--tool-server",
        "mcp.remodl.ai"
    ],
    "envs": [
        [
            "LD_LIBRARY_PATH",
            "/usr/local/lib/python3.12/dist-packages/nvidia/cuda_nvrtc/lib/:$LD_LIBRARY_PATH"
        ],
        [
            "TORCH_CUDA_ARCH_LIST",
            "8.0;8.0+PTX"
        ],
        [
            "HF_TOKEN",
            "TOKEN
        ],
        [
            "HF_HUB_OFFLINE",
            "1"
        ]
    ],
    "mounts": [
        {
            "hostpath": "/opt/inferx/cache",
            "mountpath": "/root/.cache/huggingface"
        }
    ],
    "endpoint": {
        "port": 8000,
        "schema": "Http",
        "probe": "/health",
        "probeTimeout": 1000
    },
    "version": 8458,
    "entrypoint": [
        "vllm",
        "serve"
    ],
    "resources": {
        "CPU": 15000,
        "Mem": 36000,
        "ReadyMem": 1000,
        "CacheMem": 5000,
        "GPU": {
            "Type": "Any",
            "Count": 1,
            "vRam": 36000,
            "contextCount": 0
        }
    },
    "standby": {
        "gpu": "Mem",
        "pageable": "File",
        "pinned": "File"
    },
    "sample_query": {
        "apiType": "text2text",
        "path": "v1/completions",
        "prompt": "def print_hello_world():",
        "prompts": [],
        "imageUrl": "",
        "body": {
            "max_tokens": "120",
            "model": "mistralai/Ministral-3-14B-Reasoning-2512",
            "stream": "true",
            "temperature": "0.7"
        }
    },
    "policy": {
        "Obj": {
            "min_replica": 0,
            "max_replica": 10,
            "standby_per_node": 1,
            "parallel": 2,
            "queue_len": 1000,
            "queue_timeout": 60.0,
            "scaleout_policy": {
                "WaitQueueRatio": {
                    "wait_ratio": 0.1
                }
            },
            "scalein_timeout": 0.01,
            "runtime_config": {
                "graph_sync": true
            }
        }
    }
}